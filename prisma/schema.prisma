generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ORGANIZER
  ADMIN
  SUPPORT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  SSL_COMMERZ
  BKASH
  NAGAD
  MANUAL
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id               String          @id @default(uuid()) @db.Uuid
  email            String          @unique @db.VarChar(255)
  passwordHash     String          @map("password_hash")
  fullName         String          @map("full_name") @db.VarChar(160)
  phone            String?         @db.VarChar(40)
  role             UserRole        @default(CUSTOMER)
  isActive         Boolean         @default(true) @map("is_active")
  emailVerifiedAt  DateTime?       @map("email_verified_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  events           Event[]         @relation("OrganizerEvents")
  orders           Order[]
  supportTickets   SupportTicket[]

  @@index([role])
  @@map("users")
}

model Venue {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(180)
  addressLine String   @map("address_line") @db.VarChar(255)
  city        String   @db.VarChar(100)
  country     String   @default("Bangladesh") @db.VarChar(100)
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events      Event[]

  @@index([city])
  @@map("venues")
}

model Category {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @unique @db.VarChar(100)
  slug        String          @unique @db.VarChar(120)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  events      EventCategory[]

  @@map("categories")
}

model Event {
  id             String          @id @default(uuid()) @db.Uuid
  organizerId    String          @map("organizer_id") @db.Uuid
  venueId        String?         @map("venue_id") @db.Uuid
  title          String          @db.VarChar(180)
  slug           String          @unique @db.VarChar(220)
  summary        String?         @db.VarChar(300)
  description    String
  status         EventStatus     @default(DRAFT)
  startsAt       DateTime        @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime        @map("ends_at") @db.Timestamptz(6)
  timezone       String          @default("Asia/Dhaka") @db.VarChar(80)
  coverImageUrl  String?         @map("cover_image_url") @db.VarChar(500)
  publishedAt    DateTime?       @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizer      User            @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Restrict)
  venue          Venue?          @relation(fields: [venueId], references: [id], onDelete: SetNull)
  categories     EventCategory[]
  ticketTypes    TicketType[]
  orderItems     TicketItem[]

  @@index([status, startsAt])
  @@index([organizerId, startsAt])
  @@index([venueId])
  @@map("events")
}

model EventCategory {
  eventId    String   @map("event_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([eventId, categoryId])
  @@index([categoryId])
  @@map("event_categories")
}

model TicketType {
  id             String       @id @default(uuid()) @db.Uuid
  eventId        String       @map("event_id") @db.Uuid
  name           String       @db.VarChar(120)
  description    String?      @db.VarChar(300)
  price          Decimal      @db.Decimal(12, 2)
  currency       String       @default("BDT") @db.Char(3)
  totalQuantity  Int          @map("total_quantity")
  soldQuantity   Int          @default(0) @map("sold_quantity")
  maxPerOrder    Int          @default(10) @map("max_per_order")
  saleStartsAt   DateTime?    @map("sale_starts_at") @db.Timestamptz(6)
  saleEndsAt     DateTime?    @map("sale_ends_at") @db.Timestamptz(6)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketItems    TicketItem[]

  @@unique([eventId, name])
  @@index([eventId, isActive])
  @@map("ticket_types")
}

model Order {
  id             String        @id @default(uuid()) @db.Uuid
  orderNumber    String        @unique @map("order_number") @db.VarChar(40)
  userId         String        @map("user_id") @db.Uuid
  status         OrderStatus   @default(PENDING)
  subtotal       Decimal       @db.Decimal(12, 2)
  fees           Decimal       @default(0) @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  currency       String        @default("BDT") @db.Char(3)
  expiresAt      DateTime?     @map("expires_at") @db.Timestamptz(6)
  confirmedAt    DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          TicketItem[]
  payments       Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model TicketItem {
  id             String      @id @default(uuid()) @db.Uuid
  orderId        String      @map("order_id") @db.Uuid
  eventId        String      @map("event_id") @db.Uuid
  ticketTypeId   String      @map("ticket_type_id") @db.Uuid
  quantity       Int
  unitPrice      Decimal     @map("unit_price") @db.Decimal(12, 2)
  lineTotal      Decimal     @map("line_total") @db.Decimal(12, 2)
  ticketName     String      @map("ticket_name") @db.VarChar(120)
  attendeeName   String?     @map("attendee_name") @db.VarChar(160)
  attendeeEmail  String?     @map("attendee_email") @db.VarChar(255)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event          Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType     TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([eventId])
  @@index([ticketTypeId])
  @@map("ticket_items")
}

model Payment {
  id                    String          @id @default(uuid()) @db.Uuid
  orderId               String          @map("order_id") @db.Uuid
  provider              PaymentProvider
  status                PaymentStatus   @default(PENDING)
  amount                Decimal         @db.Decimal(12, 2)
  currency              String          @default("BDT") @db.Char(3)
  providerTransactionId String?         @map("provider_transaction_id") @db.VarChar(160)
  providerPayload       Json?           @map("provider_payload")
  paidAt                DateTime?       @map("paid_at") @db.Timestamptz(6)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([provider, providerTransactionId])
  @@map("payments")
}

model SupportTicket {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  orderId     String?               @map("order_id") @db.Uuid
  subject     String                @db.VarChar(180)
  message     String
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, priority])
  @@map("support_tickets")
}
