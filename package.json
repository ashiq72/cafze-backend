{
  "name": "cafze-backend",
  "version": "1.0.0",
  "description": "REST API backend for Cafze event management and ticketing.",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiq72/cafze-backend.git"
  },
  "keywords": [
    "event-management",
    "ticketing",
    "express",
    "postgresql",
    "prisma",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ashiq72/cafze-backend/issues"
  },
  "homepage": "https://github.com/ashiq72/cafze-backend#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.14",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
